    // The veil i bent at time t (0..1): same wave as the preview (amplitude and swell grow from the first veil to the last)
    function pathOf(i, t) {
        const v = veils[i];
        const amp = 14 + 3.2 * i, waves = 1.6 + 0.12 * i, shift = 0.8 * i, lift = 7;
        const phase = 2 * Math.PI * t + shift;
        let out = "";
        for (const tok of v.tokens) {
            if (typeof tok === "string") { out += tok + " "; continue; }
            const u = Math.min(1, Math.max(0, (tok[0] - 10) / 1095));
            const env = Math.pow(Math.sin(Math.PI * u), 0.7);
            const dy = amp * env * Math.sin(2 * Math.PI * waves * u - phase) + lift * env * Math.sin(phase * 0.5);
            out += tok[0] + " " + (tok[1] + dy).toFixed(1) + " ";
        }
        return out;
    }

    Item {
        width: 1135
        height: 360
        scale: s.width / 1135
        transformOrigin: Item.TopLeft
        // Smooth edges: the veils are drawn into a multisampled layer, at the size they are shown (not at 1135 and scaled)
        layer.enabled: true
        layer.samples: 8
        layer.smooth: true
        layer.textureSize: Qt.size(Math.max(1, Math.round(s.width * 2 * Screen.devicePixelRatio)), Math.max(1, Math.round(s.height * 2 * Screen.devicePixelRatio)))
        Repeater {
            model: s.veils.length
            // One Shape per veil (a ShapePath must be a direct child of its Shape)
            delegate: Shape {
                required property int index
                x: 10
                y: 30
                preferredRendererType: Shape.CurveRenderer
                ShapePath {
                    strokeWidth: -1
                    fillGradient: LinearGradient {
                        x1: s.veils[index].x1; x2: s.veils[index].x2; y1: 0; y2: 0
                        GradientStop { position: 0.000; color: s.stopColor(index, 0) }
                        GradientStop { position: 0.125; color: s.stopColor(index, 1) }
                        GradientStop { position: 0.250; color: s.stopColor(index, 2) }
                        GradientStop { position: 0.375; color: s.stopColor(index, 3) }
                        GradientStop { position: 0.500; color: s.stopColor(index, 4) }
                        GradientStop { position: 0.625; color: s.stopColor(index, 5) }
                        GradientStop { position: 0.750; color: s.stopColor(index, 6) }
                        GradientStop { position: 0.875; color: s.stopColor(index, 7) }
                        GradientStop { position: 1.000; color: s.stopColor(index, 8) }
                    }
                    PathSvg { path: s.pathOf(index, s.t) }
                }
            }
        }
    }

    function stopColor(i, k) {
        const st = (lightVeils ? veils[i].dark : veils[i].light)[k];
        const c = Qt.color(st[1]);
        // Veils are very light by design: a little stronger so a small loader still reads
        return Qt.rgba(c.r, c.g, c.b, Math.min(1, st[2] * (lightVeils ? 1.8 : 1.3)));
    }
